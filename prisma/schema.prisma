generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  INSTITUTION_ADMIN
  TEACHER
  STUDENT
}

enum InstitutionStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum Plan {
  STARTER
  GROWTH
  CAMPUS
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionSource {
  MANUAL
  AI
}

enum SyllabusInputType {
  TOPIC
  TEXT
  IMAGE
  PDF
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssignmentStatus {
  ASSIGNED
  STARTED
  COMPLETED
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  LIVE
  CLOSED
}

enum NotificationType {
  EXAM_SCHEDULED
  EXAM_RESCHEDULED
  EXAM_REMINDER_1D
  EXAM_REMINDER_1H
  EXAM_REMINDER_15M
  EXAM_LIVE
  RESULT_AVAILABLE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
}

enum AiUsageKind {
  SYLLABUS_ANALYSIS
  QUESTION_GENERATION
  QUESTION_VARIANT
}

model Institution {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  logoUrl            String?            @map("logo_url")
  email              String?
  phone              String?
  status             InstitutionStatus  @default(ACTIVE)
  subscriptionPlan   Plan               @default(STARTER) @map("subscription_plan")
  subscriptionStatus SubscriptionStatus @default(TRIAL) @map("subscription_status")
  studentIdPrefix    String             @default("STU") @map("student_id_prefix")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  users      User[]
  students   Student[]
  classes    Class[]
  syllabuses Syllabus[]
  questions  Question[]
  tests         Test[]
  aiUsage       AiUsage[]
  notifications Notification[]

  @@map("institutions")
}

model User {
  id             String   @id @default(cuid())
  institutionId  String?  @map("institution_id")
  name           String
  email          String   @unique
  passwordHash   String   @map("password_hash")
  role           Role
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  institution    Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  student        Student?
  createdClasses Class[]      @relation("ClassCreatedBy")
  createdSyllabi Syllabus[]   @relation("SyllabusCreatedBy")
  createdTests   Test[]       @relation("TestCreatedBy")

  @@index([institutionId, role])
  @@map("users")
}

model Student {
  id                 String        @id @default(cuid())
  userId             String        @unique @map("user_id")
  institutionId      String        @map("institution_id")
  studentIdentifier  String        @unique @map("student_identifier")
  firstName          String        @map("first_name")
  lastName           String        @map("last_name")
  email              String
  phone              String?
  status             StudentStatus @default(ACTIVE)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution  Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  enrollments   ClassStudent[]
  assignments   TestAssignment[]
  attempts      StudentTestAttempt[]
  notifications Notification[]

  @@index([institutionId])
  @@map("students")
}

model Class {
  id            String   @id @default(cuid())
  institutionId String   @map("institution_id")
  name          String
  description   String?
  subject       String
  createdById   String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation("ClassCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  enrollments ClassStudent[]
  syllabuses  Syllabus[]
  questions   Question[]
  tests       Test[]

  @@index([institutionId])
  @@map("classes")
}

model ClassStudent {
  id        String   @id @default(cuid())
  classId   String   @map("class_id")
  studentId String   @map("student_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@map("class_students")
}

model Syllabus {
  id            String            @id @default(cuid())
  institutionId String            @map("institution_id")
  classId       String            @map("class_id")
  title         String
  inputType     SyllabusInputType @map("input_type")
  content       String
  fileUrl       String?           @map("file_url")
  analyzedJson  Json              @default("{}") @map("analyzed_json")
  createdById   String?           @map("created_by")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  institution Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  class       Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation("SyllabusCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  topics      SyllabusTopic[]
  questions   Question[]
  tests       Test[]

  @@index([institutionId, classId])
  @@map("syllabuses")
}

model SyllabusTopic {
  id            String  @id @default(cuid())
  syllabusId    String  @map("syllabus_id")
  name          String
  parentTopicId String? @map("parent_topic_id")
  weightage     Float   @default(0)

  syllabus Syllabus        @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  parent   SyllabusTopic?  @relation("TopicTree", fields: [parentTopicId], references: [id], onDelete: SetNull)
  children SyllabusTopic[] @relation("TopicTree")
  questions Question[]

  @@index([syllabusId])
  @@map("syllabus_topics")
}

model Question {
  id                 String         @id @default(cuid())
  institutionId      String         @map("institution_id")
  classId            String         @map("class_id")
  syllabusId         String?        @map("syllabus_id")
  topicId            String?        @map("topic_id")
  questionText       String         @map("question_text")
  optionsJson        Json           @map("options_json")
  correctAnswer      String         @map("correct_answer")
  explanation        String?
  difficulty         Difficulty     @default(MEDIUM)
  questionHash       String         @map("question_hash")
  embeddingRef       String?        @map("embedding_ref")
  subtopic           String?
  syllabusReference  String?        @map("syllabus_reference")
  source             QuestionSource @default(AI)
  usageCount         Int            @default(0) @map("usage_count")
  aiMetadata         Json           @default("{}") @map("ai_metadata")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  institution Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  class       Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  syllabus    Syllabus?       @relation(fields: [syllabusId], references: [id], onDelete: SetNull)
  topic       SyllabusTopic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  tests       TestQuestion[]
  answers     StudentAnswer[]

  @@unique([institutionId, questionHash])
  @@index([institutionId, classId, difficulty])
  @@index([usageCount])
  @@map("questions")
}

model Test {
  id               String     @id @default(cuid())
  institutionId    String     @map("institution_id")
  classId          String     @map("class_id")
  syllabusId       String?    @map("syllabus_id")
  title            String
  durationMinutes  Int        @default(30) @map("duration_minutes")
  totalQuestions   Int        @map("total_questions")
  status           TestStatus @default(DRAFT)
  examStatus       ExamStatus @default(DRAFT) @map("exam_status")
  examDate         DateTime?  @map("exam_date")
  startAt          DateTime?  @map("start_at")
  endAt            DateTime?  @map("end_at")
  variationCount   Int        @default(3) @map("variation_count")
  publishedAt      DateTime?  @map("published_at")
  createdById      String?    @map("created_by")
  distributionJson Json       @default("{}") @map("distribution_json")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  institution  Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  class        Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  syllabus     Syllabus?            @relation(fields: [syllabusId], references: [id], onDelete: SetNull)
  createdBy    User?                @relation("TestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  questions    TestQuestion[]
  papers       PaperVariation[]
  assignments  TestAssignment[]
  attempts     StudentTestAttempt[]
  notifications Notification[]

  @@index([institutionId, classId, status])
  @@index([startAt, endAt])
  @@map("tests")
}

model PaperVariation {
  id               String @id @default(cuid())
  testId           String @map("test_id")
  label            String
  questionIdsJson  Json   @map("question_ids_json")
  sortOrder        Int    @default(0) @map("sort_order")

  test        Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  assignments TestAssignment[]

  @@unique([testId, label])
  @@map("paper_variations")
}

model TestQuestion {
  id              String @id @default(cuid())
  testId          String @map("test_id")
  questionId      String @map("question_id")
  questionOrder   Int    @map("question_order")
  optionOrderJson Json   @map("option_order_json")

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId])
  @@index([testId, questionOrder])
  @@map("test_questions")
}

model TestAssignment {
  id                 String           @id @default(cuid())
  testId             String           @map("test_id")
  studentId          String           @map("student_id")
  paperVariationId   String?          @map("paper_variation_id")
  questionOrderJson  Json             @default("[]") @map("question_order_json")
  optionOrderJson    Json             @default("{}") @map("option_order_json")
  assignedAt         DateTime         @default(now()) @map("assigned_at")
  status             AssignmentStatus @default(ASSIGNED)

  test    Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  student Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paper   PaperVariation?  @relation(fields: [paperVariationId], references: [id], onDelete: SetNull)
  attempts StudentTestAttempt[]

  @@unique([testId, studentId])
  @@index([studentId, status])
  @@map("test_assignments")
}

model StudentTestAttempt {
  id                   String        @id @default(cuid())
  studentId            String        @map("student_id")
  testId               String        @map("test_id")
  assignmentId         String?       @map("assignment_id")
  startedAt            DateTime      @default(now()) @map("started_at")
  submittedAt          DateTime?     @map("submitted_at")
  status               AttemptStatus @default(IN_PROGRESS)
  totalQuestions       Int           @map("total_questions")
  correctAnswers       Int           @default(0) @map("correct_answers")
  wrongAnswers         Int           @default(0) @map("wrong_answers")
  unansweredQuestions  Int           @default(0) @map("unanswered_questions")
  score                Float         @default(0)
  percentage           Float         @default(0)
  timeTakenSeconds     Int           @default(0) @map("time_taken_seconds")
  remainingSeconds     Int           @map("remaining_seconds")
  currentQuestionIndex Int           @default(0) @map("current_question_index")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test       Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  assignment TestAssignment?  @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  answers    StudentAnswer[]

  @@unique([studentId, testId])
  @@index([testId, status])
  @@map("student_test_attempts")
}

model StudentAnswer {
  id               String   @id @default(cuid())
  attemptId        String   @map("attempt_id")
  questionId       String   @map("question_id")
  selectedAnswer   String?  @map("selected_answer")
  isCorrect        Boolean? @map("is_correct")
  answeredAt       DateTime @default(now()) @map("answered_at")
  timeSpentSeconds Int      @default(0) @map("time_spent_seconds")

  attempt  StudentTestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question           @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@map("student_answers")
}

model Notification {
  id             String              @id @default(cuid())
  institutionId  String              @map("institution_id")
  studentId      String              @map("student_id")
  testId         String?             @map("test_id")
  type           NotificationType
  channel        NotificationChannel @default(IN_APP)
  title          String
  body           String
  readAt         DateTime?           @map("read_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test        Test?       @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([studentId, testId, type])
  @@index([studentId, readAt])
  @@map("notifications")
}

model AiUsage {
  id                  String      @id @default(cuid())
  institutionId       String      @map("institution_id")
  kind                AiUsageKind
  questionsGenerated  Int         @default(0) @map("questions_generated")
  createdAt           DateTime    @default(now()) @map("created_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId, createdAt])
  @@map("ai_usage")
}
